# Brevo — correo transaccional de los formularios (server-side).
# Copia este archivo a .env.local (local) o define estas variables en el
# servidor. Nunca pongas valores reales aquí: este archivo es una plantilla.
BREVO_API_KEY=

# Remitente verificado en Brevo (sugerencia: info@antaestudio.com)
BREVO_SENDER_EMAIL=

# Destino de los correos de contacto (sugerencia: info@antaestudio.com)
BREVO_TO_EMAIL=

# Ambiente de prueba: "true" bloquea indexación (X-Robots-Tag + robots.txt).
# Quitar/dejar vacía al lanzar. Cambiarla requiere redeploy.
NOINDEX=

# Google Tag Manager — ID del contenedor (formato GTM-XXXXXXX). Vacía = GTM
# desactivado (no se carga nada). Se incrusta en el build: cambiarla requiere
# rebuild. Dejarla vacía en el ambiente de prueba para no mezclar tráfico.
NEXT_PUBLIC_GTM_ID=
